# Copy to .env.local and adjust. Never commit real values.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser —
# keep API keys and secrets un-prefixed so they stay server-side.

# Public canonical URL used for metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only for the real production launch. While false,
# robots.txt asks search engines not to index the design preview.
ALLOW_INDEXING=false
